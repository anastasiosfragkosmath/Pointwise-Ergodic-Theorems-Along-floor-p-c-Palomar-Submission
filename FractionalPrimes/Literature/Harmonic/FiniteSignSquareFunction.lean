module

public import FractionalPrimes.Literature.Harmonic.FrequencyResolutionSquareFunction

/-!
# Finite-sign randomization for square functions

This file packages the lower Rademacher moment estimate with a uniform bound
for every finite signed sum of operators. It is the finite-index step in the
Littlewood--Paley estimate from `ha:lp`.
-/

@[expose] public section

open scoped BigOperators ENNReal

namespace FractionalPrimes.Literature.Harmonic

open FractionalPrimes.Literature.JSW

noncomputable section

/-- The operator associated to one assignment of signs on a finite family.
The recursive definition matches `jswSignSum` exactly. -/
def finiteSignedProjectionOperator {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] :
    (n : ℕ) → jswSignSpace n →
      (Fin n → lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
        lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)) →
      lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
        lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)
  | 0, _, _ => 0
  | n + 1, (b, ω), T =>
      (jswSign b : ℂ) • T 0 +
        finiteSignedProjectionOperator n ω (fun i => T i.succ)

/-- Pointwise, the recursively defined operator is the signed sum of the
corresponding sequence values. -/
theorem finiteSignedProjectionOperator_apply {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (n : ℕ) (ω : jswSignSpace n)
    (T : Fin n → lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
      lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p))
    (f : lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)) (x : ℤ) :
    finiteSignedProjectionOperator n ω T f x =
      jswSignSum n ω (fun i => T i f x) := by
  induction n with
  | zero =>
      cases ω
      simp [finiteSignedProjectionOperator, jswSignSum]
  | succ n ih =>
      cases ω with
      | mk b ω =>
          simp only [finiteSignedProjectionOperator, jswSignSum,
            ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
            lp.coeFn_add, lp.coeFn_smul,
            Pi.add_apply, Pi.smul_apply, smul_eq_mul, ih]

/-- The Euclidean size of a finite vector of complex values. -/
def finiteCoordinateSquare (n : ℕ) (z : Fin n → ℂ) : ℝ :=
  Real.sqrt (∑ i, ‖z i‖ ^ 2)

/-- The finite sign moment controls the `p`th power of the Euclidean size of
the coefficient vector, with the exact constant from `ha:signs`. -/
theorem finiteSignMoment_controls_coordinateSquare
    (n : ℕ) (z : Fin n → ℂ) {p : ℝ} (hp : 0 < p) :
    Finset.expect (Finset.univ : Finset (jswSignSpace n))
        (fun ω => Real.rpow ‖jswSignSum n ω z‖ p) ≥
      Real.rpow 2 (-p / 2) / 12 *
        Real.rpow (finiteCoordinateSquare n z) p := by
  have henergy : 0 ≤ ∑ i, ‖z i‖ ^ 2 :=
    Finset.sum_nonneg fun i hi => sq_nonneg ‖z i‖
  have hmoment := FractionalPrimes.finiteSignLowerMoment n z hp
  have hpow : Real.rpow (∑ i, ‖z i‖ ^ 2) (p / 2) =
      Real.rpow (Real.sqrt (∑ i, ‖z i‖ ^ 2)) p := by
    exact Real.rpow_div_two_eq_sqrt p henergy
  rw [hpow] at hmoment
  simpa [finiteCoordinateSquare] using hmoment

/-- The finite square function generated by a family of sequence operators. -/
def finiteProjectionSquareFunction {p : ℝ}
    [Fact (1 ≤ ENNReal.ofReal p)] (n : ℕ)
    (T : Fin n → lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
      lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p))
    (f : lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)) (x : ℤ) : ℝ :=
  finiteCoordinateSquare n (fun i => T i f x)

private theorem finiteExpectMonoReal {α : Type*} (s : Finset α)
    (f g : α → ℝ) (h : ∀ x ∈ s, f x ≤ g x) :
    Finset.expect s f ≤ Finset.expect s g := by
  simp only [Finset.expect, NNRat.smul_def]
  exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum h) (by positivity)

/-- The finite sign method converts uniform bounds for all signed sums into
a finite Littlewood--Paley estimate. This statement uses exactly the source
constant obtained from `ha:signs`. -/
theorem finiteProjectionSquareFunction_sum_rpow_le
    {p M : ℝ} (hp : 1 < p) (hM : 0 ≤ M) {n : ℕ}
    [Fact (1 ≤ ENNReal.ofReal p)]
    (T : Fin n → lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
      lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p))
    (hT : ∀ ω : jswSignSpace n,
      ‖finiteSignedProjectionOperator n ω T‖ ≤ M)
    (f : lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)) (s : Finset ℤ) :
    ∑ x ∈ s, Real.rpow (finiteProjectionSquareFunction n T f x) p ≤
      12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p ∧
    0 ≤ 12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p := by
  let a : ℝ := Real.rpow 2 (-p / 2) / 12
  let b : ℝ := 12 * Real.rpow 2 (p / 2)
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpENN : 0 < (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hp0.le]
    exact hp0
  have hreciprocal : b * a = 1 := by
    calc
      b * a = Real.rpow 2 (p / 2) * Real.rpow 2 (-p / 2) := by
        dsimp [a, b]
        ring
      _ = Real.rpow 2 (p / 2 + -p / 2) :=
        (Real.rpow_add (by norm_num : (0 : ℝ) < 2) _ _).symm
      _ = 1 := by
        rw [show p / 2 + -p / 2 = 0 by ring]
        exact Real.rpow_zero 2
  have hbpos : 0 < b := by
    dsimp [b]
    positivity
  have hmomentPoint (x : ℤ) :
      a * Real.rpow (finiteProjectionSquareFunction n T f x) p ≤
        Finset.expect (Finset.univ : Finset (jswSignSpace n))
          (fun ω => Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) := by
    have hmoment := finiteSignMoment_controls_coordinateSquare n
      (fun i => T i f x) hp0
    have heq : Finset.expect (Finset.univ : Finset (jswSignSpace n))
        (fun ω => Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) =
      Finset.expect (Finset.univ : Finset (jswSignSpace n))
        (fun ω => Real.rpow ‖jswSignSum n ω (fun i => T i f x)‖ p) := by
      apply Finset.expect_congr rfl
      intro ω hω
      rw [finiteSignedProjectionOperator_apply]
    rw [heq]
    simpa [a, finiteProjectionSquareFunction, finiteCoordinateSquare] using hmoment
  have hfiniteBound : ∀ ω : jswSignSpace n,
      ∑ x ∈ s, Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p ≤
        (M * ‖f‖) ^ p := by
    intro ω
    have hopen : ‖finiteSignedProjectionOperator n ω T f‖ ≤ M * ‖f‖ := by
      calc
        _ ≤ ‖finiteSignedProjectionOperator n ω T‖ * ‖f‖ :=
          (finiteSignedProjectionOperator n ω T).le_opNorm f
        _ ≤ M * ‖f‖ := mul_le_mul_of_nonneg_right (hT ω) (norm_nonneg _)
    have hpow := Real.rpow_le_rpow (norm_nonneg _) hopen hp0.le
    have hsum := lp.sum_rpow_le_norm_rpow hpENN
      (finiteSignedProjectionOperator n ω T f) s
    have htoReal : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal hp0.le
    have hsum' :
        ∑ x ∈ s, ‖finiteSignedProjectionOperator n ω T f x‖ ^ p ≤
          ‖finiteSignedProjectionOperator n ω T f‖ ^ p := by
      simpa only [htoReal] using hsum
    exact hsum'.trans hpow
  have hsumAverage :
      a * ∑ x ∈ s, Real.rpow (finiteProjectionSquareFunction n T f x) p ≤
        Finset.expect (Finset.univ : Finset (jswSignSpace n))
          (fun ω => ∑ x ∈ s,
            Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) := by
    calc
      _ = ∑ x ∈ s,
          a * Real.rpow (finiteProjectionSquareFunction n T f x) p := by
        rw [Finset.mul_sum]
      _ ≤ ∑ x ∈ s,
          Finset.expect (Finset.univ : Finset (jswSignSpace n))
            (fun ω => Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) :=
        Finset.sum_le_sum fun x hx => hmomentPoint x
      _ = Finset.expect (Finset.univ : Finset (jswSignSpace n))
          (fun ω => ∑ x ∈ s,
            Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) := by
        rw [Finset.expect_sum_comm]
  have hsumTop :
      Finset.expect (Finset.univ : Finset (jswSignSpace n))
          (fun ω => ∑ x ∈ s,
            Real.rpow ‖finiteSignedProjectionOperator n ω T f x‖ p) ≤
        (M * ‖f‖) ^ p := by
    calc
      _ ≤ Finset.expect (Finset.univ : Finset (jswSignSpace n))
          (fun _ => (M * ‖f‖) ^ p) :=
        finiteExpectMonoReal Finset.univ _ _ (by
          intro ω hω
          exact hfiniteBound ω)
      _ = (M * ‖f‖) ^ p := by simp
  have hsum := hsumAverage.trans hsumTop
  constructor
  · calc
      ∑ x ∈ s, Real.rpow (finiteProjectionSquareFunction n T f x) p =
          b * (a * ∑ x ∈ s,
            Real.rpow (finiteProjectionSquareFunction n T f x) p) := by
        calc
          _ = (b * a) * ∑ x ∈ s,
              Real.rpow (finiteProjectionSquareFunction n T f x) p := by
            rw [hreciprocal]
            simp
          _ = b * (a * ∑ x ∈ s,
              Real.rpow (finiteProjectionSquareFunction n T f x) p) := mul_assoc _ _ _
      _ ≤ b * (M * ‖f‖) ^ p := mul_le_mul_of_nonneg_left hsum hbpos.le
      _ = 12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p := by
        rfl
  · exact mul_nonneg (by positivity)
      (Real.rpow_nonneg (mul_nonneg hM (norm_nonneg _)) _)

/-- The finite square-function estimate in sequence `ℓᵖ`, with the exact
constant `sqrt 2 · 12^(1/p)` supplied by the source finite-sign moment. -/
theorem finiteProjectionSquareFunction_memLp_norm_le
    {p M : ℝ} (hp : 1 < p) (hM : 0 ≤ M) {n : ℕ}
    [Fact (1 ≤ ENNReal.ofReal p)]
    (T : Fin n → lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p) →L[ℂ]
      lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p))
    (hT : ∀ ω : jswSignSpace n,
      ‖finiteSignedProjectionOperator n ω T‖ ≤ M)
    (f : lp (fun _ : ℤ => ℂ) (ENNReal.ofReal p)) :
    ∃ g : lp (fun _ : ℤ => ℝ) (ENNReal.ofReal p),
      (∀ x, g x = finiteProjectionSquareFunction n T f x) ∧
      ‖g‖ ≤ Real.sqrt 2 * Real.rpow 12 (1 / p) * (M * ‖f‖) := by
  let q : ℤ → ℝ := finiteProjectionSquareFunction n T f
  let C : ℝ := Real.sqrt 2 * Real.rpow 12 (1 / p) * (M * ‖f‖)
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have htoReal : (ENNReal.ofReal p).toReal = p := ENNReal.toReal_ofReal hp0.le
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    exact mul_nonneg
      (mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (by norm_num) _))
      (mul_nonneg hM (norm_nonneg _))
  have hrootTwo : (Real.sqrt 2) ^ p = Real.rpow 2 (p / 2) := by
    calc
      (Real.sqrt 2) ^ p = (Real.rpow 2 (1 / 2 : ℝ)) ^ p := by
        rw [show Real.sqrt 2 = Real.rpow 2 (1 / 2 : ℝ) from by
          simpa using (Real.sqrt_eq_rpow (2 : ℝ))]
      _ = Real.rpow 2 ((1 / 2 : ℝ) * p) :=
        (Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2) _ _).symm
      _ = Real.rpow 2 (p / 2) := by congr 1 <;> ring
  have hrootTwelve : (Real.rpow 12 (1 / p)) ^ p = 12 := by
    calc
      (Real.rpow 12 (1 / p)) ^ p = Real.rpow 12 ((1 / p) * p) :=
        (Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 12) _ _).symm
      _ = Real.rpow 12 1 := by congr 1; field_simp [ne_of_gt hp0]
      _ = 12 := Real.rpow_one 12
  have hbase : 0 ≤ M * ‖f‖ := mul_nonneg hM (norm_nonneg _)
  have hCpow : C ^ p = 12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p := by
    calc
      C ^ p =
          (Real.sqrt 2 * Real.rpow 12 (1 / p)) ^ p * (M * ‖f‖) ^ p := by
        dsimp [C]
        rw [Real.mul_rpow
          (mul_nonneg (Real.sqrt_nonneg _) (Real.rpow_nonneg (by norm_num) _)) hbase]
      _ = (Real.sqrt 2) ^ p * (Real.rpow 12 (1 / p)) ^ p *
          (M * ‖f‖) ^ p := by
        exact congrArg (fun y : ℝ => y * (M * ‖f‖) ^ p)
          (Real.mul_rpow (Real.sqrt_nonneg _)
            (Real.rpow_nonneg (by norm_num : (0 : ℝ) ≤ 12) _))
      _ = Real.rpow 2 (p / 2) * 12 * (M * ‖f‖) ^ p := by
        rw [hrootTwo, hrootTwelve]
      _ = 12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p := by ring
  have hfinite : ∀ s : Finset ℤ,
      ∑ x ∈ s, ‖q x‖ ^ (ENNReal.ofReal p).toReal ≤ C ^ (ENNReal.ofReal p).toReal := by
    intro s
    have hpowered := (finiteProjectionSquareFunction_sum_rpow_le hp hM T hT f s).1
    have hqnonneg (x : ℤ) : 0 ≤ q x := by
      dsimp [q, finiteProjectionSquareFunction, finiteCoordinateSquare]
      exact Real.sqrt_nonneg _
    have hsumEq :
        (∑ x ∈ s, ‖q x‖ ^ (ENNReal.ofReal p).toReal) =
          ∑ x ∈ s, Real.rpow (finiteProjectionSquareFunction n T f x) p := by
      apply Finset.sum_congr rfl
      intro x hx
      calc
        ‖q x‖ ^ (ENNReal.ofReal p).toReal = q x ^ p := by
          rw [htoReal, Real.norm_eq_abs, abs_of_nonneg (hqnonneg x)]
        _ = Real.rpow (finiteProjectionSquareFunction n T f x) p := by
          simp [q]
    calc
      ∑ x ∈ s, ‖q x‖ ^ (ENNReal.ofReal p).toReal =
          ∑ x ∈ s, Real.rpow (finiteProjectionSquareFunction n T f x) p := hsumEq
      _ ≤ 12 * Real.rpow 2 (p / 2) * (M * ‖f‖) ^ p := hpowered
      _ = C ^ (ENNReal.ofReal p).toReal := by rw [htoReal, hCpow]
  have hmem : Memℓp q (ENNReal.ofReal p) := memℓp_gen' hfinite
  let g : lp (fun _ : ℤ => ℝ) (ENNReal.ofReal p) := ⟨q, hmem⟩
  have hpLp : 0 < (ENNReal.ofReal p).toReal := by rw [htoReal]; exact hp0
  have hnorm : ‖g‖ ≤ C := by
    apply lp.norm_le_of_forall_sum_le hpLp hCnonneg
    intro s
    calc
      ∑ x ∈ s, ‖g x‖ ^ (ENNReal.ofReal p).toReal =
          ∑ x ∈ s, ‖q x‖ ^ (ENNReal.ofReal p).toReal := by
            apply Finset.sum_congr rfl
            intro x hx
            simp [g]
      _ ≤ C ^ (ENNReal.ofReal p).toReal := hfinite s
  refine ⟨g, ?_, ?_⟩
  · intro x
    rfl
  · simpa [C] using hnorm

end

end FractionalPrimes.Literature.Harmonic

end
