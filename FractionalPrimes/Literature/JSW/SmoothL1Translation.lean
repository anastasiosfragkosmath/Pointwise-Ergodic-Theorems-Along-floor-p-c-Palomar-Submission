        ‖h‖ * ∫ x : ℝ, D x := by
    rw [← hswap]
    have hleft : (fun t : ℝ => ∫ x : ℝ, F (t, x)) =
        fun _ : ℝ => ‖h‖ * ∫ x : ℝ, D x := by
      funext t
      calc
        (∫ x : ℝ, F (t, x)) = ∫ x : ℝ, ‖F (t, x)‖ := by
          apply integral_congr_ae
          filter_upwards with x
          exact (Real.norm_of_nonneg
            (mul_nonneg (norm_nonneg _) (norm_nonneg _))).symm
        _ = _ := hFfiber_norm t
    rw [hleft]
    change (∫ t in Ioc (0 : ℝ) 1, ‖h‖ * ∫ x : ℝ, D x) = _
    rw [setIntegral_const]
    have hvol : volume.real (Ioc (0 : ℝ) 1) = 1 := by
      rw [Measure.real, Real.volume_Ioc]
      norm_num
    rw [hvol]
    simp
  have hpoint (x : ℝ) :
      ‖f (x + h) - f x‖ ≤ ∫ t : ℝ in (0 : ℝ)..1, F (t, x) := by
    have hline_cont : Continuous (fun t : ℝ => f (x + t • h)) :=
      hf.continuous.comp
        (continuous_const.add (continuous_id.smul continuous_const))
    have hline_diff : DifferentiableOn ℝ (fun t : ℝ => f (x + t • h))
        (Ioo (0 : ℝ) 1) := by
      intro t _
      simpa [Function.comp_def] using
        ((hf.differentiable (by norm_num)).differentiableAt.comp t
          ((hasDerivAt_const t x).add
              ((hasDerivAt_id t).smul_const h)).differentiableAt).differentiableWithinAt
    have hline := norm_sub_le_integral_of_norm_deriv_le_of_le
