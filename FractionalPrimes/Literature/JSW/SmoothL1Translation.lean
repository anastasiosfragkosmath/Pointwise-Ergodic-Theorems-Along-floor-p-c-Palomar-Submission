        ∫ x : ℝ, ∫ t : ℝ, F (t, x) ∂μ :=
      integral_mono_ae hleft_int hright_int (Filter.Eventually.of_forall hpoint')
    _ = ‖h‖ * ∫ x : ℝ, D x := hright
    _ = _ := by rfl


theorem integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
    (f : ℝ → ℂ) (hf : ContDiff ℝ 1 f)
    (hdf : Integrable (fderiv ℝ f) volume) (h : ℝ) :
    (∫ x : ℝ, ‖f (x+h)-f x‖ ∂volume) ≤
      ‖h‖*(∫ x : ℝ, ‖fderiv ℝ f x‖ ∂volume) :=
  (integrable_norm_sub_translate_and_le_fderiv f hf hdf h).2

theorem integrable_sub_translate_and_norm_le_deriv
    {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]
    (f : ℝ → G) (hf : ContDiff ℝ 1 f)
    (hdf : Integrable (deriv f) volume) (h : ℝ) :
    Integrable (fun x : ℝ => f (x+h)-f x) volume ∧
    (∫ x : ℝ, ‖f (x+h)-f x‖ ∂volume) ≤
      |h| *(∫ x : ℝ, ‖deriv f x‖ ∂volume) := by
  have hfdmeas : AEStronglyMeasurable (fderiv ℝ f) volume :=
    (hf.continuous_fderiv (by norm_num)).aestronglyMeasurable
  have hfd : Integrable (fderiv ℝ f) volume := by
    apply hdf.norm.mono' hfdmeas
    filter_upwards [] with x
    exact le_of_eq (norm_deriv_eq_norm_fderiv (f := f) (x := x)).symm
  obtain ⟨hint,hbound⟩ := integrable_norm_sub_translate_and_le_fderiv f hf hfd h
  constructor
  · apply hint.mono' (((hf.continuous.comp (continuous_id.add continuous_const)).sub
      hf.continuous).aestronglyMeasurable)
    filter_upwards [] with x
    exact le_rfl
  · simpa only [Real.norm_eq_abs, ← norm_deriv_eq_norm_fderiv] using hbound

