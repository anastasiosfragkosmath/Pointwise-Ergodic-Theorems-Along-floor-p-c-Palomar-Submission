    change (∫ x : ℝ, ‖‖h‖ * D (x + t • h)‖) = _
    calc
      (∫ x : ℝ, ‖‖h‖ * D (x + t • h)‖) =
          ∫ x : ℝ, ‖h‖ * D (x + t • h) := by
            apply integral_congr_ae
            filter_upwards with x
            exact Real.norm_of_nonneg
