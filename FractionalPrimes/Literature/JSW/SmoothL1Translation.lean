      _ = _ := by rw [integral_const_mul, integral_add_right_eq_self]
  have hFprod : Integrable F (μ.prod volume) := by
    apply (integrable_prod_iff hFmeas).mpr
    constructor
    · filter_upwards with t
      exact hFfiber t
    · have hconst : Integrable (fun _ : ℝ => ‖h‖ * ∫ x : ℝ, D x) μ := by
        change IntegrableOn (fun _ : ℝ => ‖h‖ * ∫ x : ℝ, D x)
          (Ioc (0 : ℝ) 1) volume
        exact integrableOn_const (measure_Ioc_lt_top.ne)
