    {G : Type*} [NormedAddCommGroup G] [NormedSpace ℝ G] [CompleteSpace G]
    (f : ℝ → G) (hf : ContDiff ℝ 1 f)
    (hdf : Integrable (fderiv ℝ f) volume) (h : ℝ) :
    Integrable (fun x : ℝ => ‖f (x+h)-f x‖) volume ∧
    (∫ x : ℝ, ‖f (x + h) - f x‖) ≤
      ‖h‖ * ∫ x : ℝ, ‖fderiv ℝ f x‖ := by
