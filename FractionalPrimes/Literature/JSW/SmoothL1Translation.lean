  have hDcont : Continuous D := by
    exact (hf.continuous_fderiv (by norm_num)).norm
  have hFcont : Continuous F := by
    apply continuous_const.mul
    exact hDcont.comp
      (continuous_snd.add (continuous_fst.smul continuous_const))
  have hFmeas : AEStronglyMeasurable F (μ.prod volume) :=
    hFcont.aestronglyMeasurable
  have hFfiber (t : ℝ) : Integrable (fun x : ℝ => F (t, x)) volume := by
    change Integrable (fun x : ℝ => ‖h‖ * D (x + t • h)) volume
    exact (hdf.norm.comp_add_right (t • h)).const_mul _
  have hFfiber_norm (t : ℝ) :
